rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Private User Document Storage Path: users/{userId}/documents/{documentFile}
    match /users/{userId}/documents/{documentFile} {
      // Allow read, write, delete ONLY if authenticated user matches the path userId
      allow read, write, delete: if request.auth != null 
                                 && request.auth.uid == userId
                                 && request.resource.size < 10 * 1024 * 1024
                                 && (request.resource.contentType.matches('application/pdf')
                                     || request.resource.contentType.matches('image/.*'));
      
      // Allow read/delete for existing files belonging to authenticated user
      allow read, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
