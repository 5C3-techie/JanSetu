rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User Profile: Only authenticated owner can read/write their profile
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Citizen Documents Metadata: Only authenticated owner can read/write/delete their document metadata
    match /documents/{documentId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Reminders: Only authenticated owner can read/write/delete their reminders
    match /reminders/{reminderId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Saved Schemes: Only authenticated owner can manage their saved schemes
    match /savedSchemes/{savedSchemeId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Scheme Knowledge Base: Read-only for authenticated and public users, writable only by admin
    match /schemes/{schemeId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
